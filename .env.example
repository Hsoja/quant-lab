# Copia este archivo a .env y pon tus propios valores. .env nunca se sube al repo.

# Obligatorio para descargar de SEC EDGAR: identifica tu script ante la SEC.
# Formato libre, pero debe incluir un contacto. No usar datos personales si el
# repo es o será público; un correo de proyecto o un placeholder es suficiente.
EDGAR_CONTACT="QuantLab-MVP contact@example.org"

# Se añade en fases posteriores (resumen con LLM). Vacío por ahora.
ANTHROPIC_API_KEY=
